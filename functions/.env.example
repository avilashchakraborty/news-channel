# Copy to .env for local emulator runs. In production these are set as
# Cloud Functions secrets (firebase functions:secrets:set NAME) — never commit real values.

# --- Bunny Stream ---
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=vz-xxxx.b-cdn.net
BUNNY_WEBHOOK_SECRET=
# Optional: enable Bunny token authentication on playback and set the CDN token key.
BUNNY_TOKEN_AUTH_KEY=

# --- Cloudinary (ID-proof images, signed delivery only) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Vercel ISR revalidation ---
VERCEL_REVALIDATE_URL=
VERCEL_REVALIDATE_SECRET=

# --- Crypto ---
# 32-byte AES-256 key. Hex (64 chars) preferred; any string is hashed to 32 bytes.
PHONE_ENCRYPTION_KEY=
