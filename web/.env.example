# Firebase Admin credentials for server-side Firestore reads.
# Provide ONE of:
#   FIREBASE_SERVICE_ACCOUNT  = the service-account JSON (single line), or
#   GOOGLE_APPLICATION_CREDENTIALS = path to the JSON file (applicationDefault)
# With neither set, the site renders from built-in sample data.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=gplus-india-news

# Must match the backend's VERCEL_REVALIDATE_SECRET so onVideoPublished can
# trigger ISR revalidation of the affected pages.
VERCEL_REVALIDATE_SECRET=

# Default tenant slug the root routes resolve to.
NEXT_PUBLIC_DEFAULT_TENANT=gplus
